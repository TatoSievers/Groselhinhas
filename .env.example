# Copie este arquivo para .env e preencha. O .env NÃO vai para o git.

# TMDB — https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=

# Supabase — Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# A chave do Gemini NÃO entra aqui.
# Ela vive só no servidor, como secret da Edge Function:
#   supabase secrets set GEMINI_API_KEY=sua_chave
